# Claude Halla — Environment Variables Reference
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# ${VAR} placeholders in config.yaml are substituted from the environment
# at startup. Missing required variables will cause the server to refuse to start.

# ── Required ──────────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWTs.
# Must be at least 32 bytes long. Use a randomly generated value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
CLAUDE_HALLA_JWT_SECRET=replace-me-with-at-least-32-chars-of-random-secret

# Password for the LDAP service account specified in config.yaml's bind_dn.
LDAP_BIND_PASSWORD=your-ldap-service-account-password

# ── Optional ──────────────────────────────────────────────────────────────────

# Path to the config.yaml file. Defaults to "config.yaml" in the working directory.
# CLAUDE_HALLA_CONFIG=/etc/claude-halla/config.yaml
